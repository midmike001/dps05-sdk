<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.DeepalS05Sample" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorPrimaryVariant">@color/brand_primary_dark</item>
        <item name="colorOnPrimary">#000000</item>
        <item name="colorSecondary">@color/brand_accent</item>
        <item name="colorOnSecondary">#000000</item>
        <item name="android:statusBarColor">@color/brand_bg</item>
        <item name="android:navigationBarColor">@color/brand_nav_bg</item>
        <item name="android:windowBackground">@color/brand_bg</item>
    </style>

    <style name="AutomotiveCard">
        <item name="cardCornerRadius">14dp</item>
        <item name="cardElevation">3dp</item>
        <item name="cardBackgroundColor">@color/brand_card_bg</item>
        <item name="strokeColor">@color/brand_card_stroke</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="AutomotiveButton" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">10dp</item>
        <item name="backgroundTint">@color/brand_card_stroke</item>
        <item name="android:textColor">@color/brand_text_primary</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="AutomotiveButton.Primary" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">10dp</item>
        <item name="backgroundTint">@color/brand_primary</item>
        <item name="android:textColor">#000000</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>
